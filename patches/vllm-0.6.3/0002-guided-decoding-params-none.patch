From c71ffef6f810c7cdd360621ca6df8417fee56c78 Mon Sep 17 00:00:00 2001
From: Contributor <contributor@users.noreply.github.com>
Date: Fri, 23 Oct 2026 09:30:15 +0800
Subject: [PATCH 2/2] GuidedDecodingParams.from_optional returns None when empty

---
 vllm/sampling_params.py | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/vllm/sampling_params.py b/vllm/sampling_params.py
index 4f2ae75..66f0eff 100644
--- a/vllm/sampling_params.py
+++ b/vllm/sampling_params.py
@@ -49,17 +49,20 @@ class GuidedDecodingParams:
 
     @staticmethod
     def from_optional(
-        json: Optional[Union[Dict, BaseModel, str]],
+        json: Optional[Union[Dict, BaseModel, str]] = None,
         regex: Optional[str] = None,
         choice: Optional[List[str]] = None,
         grammar: Optional[str] = None,
         json_object: Optional[bool] = None,
         backend: Optional[str] = None,
         whitespace_pattern: Optional[str] = None,
-    ) -> "GuidedDecodingParams":
-        # Extract json schemas from pydantic models
+    ) -> Optional["GuidedDecodingParams"]:
+        # Jetson patch: return None when no guided fields, so normal
+        # requests do not lazy-import outlines (broken deps / np.bool).
         if isinstance(json, (BaseModel, type(BaseModel))):
             json = json.model_json_schema()
+        if all(v is None for v in (json, regex, choice, grammar, json_object)):
+            return None
         return GuidedDecodingParams(
             json=json,
             regex=regex,
